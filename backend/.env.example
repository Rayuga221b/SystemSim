# development (default) or production. In production, DATABASE_URL and
# JWT_SECRET become hard requirements at startup instead of soft dev fallbacks.
ENVIRONMENT=development

CORS_ORIGINS=http://localhost:5173

# Postgres — local: matches docker-compose.yml credentials
# Prod: set this to your Neon connection string
DATABASE_URL=postgresql://systemsim:systemsim@localhost:5432/systemsim

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Gemini — RAG embeddings (services/embeddings.py); generation kept for
# provider swap-back only. Changing EMBEDDING_MODEL or EMBEDDING_DIM requires
# a full index rebuild: python -m services.rag_index build --force
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Groq — simulation explainer (/ai/explain), roadmap ingest, and mentor/chat
# generation (/ai/mentor, /ai/chat). All in-app AI generation runs on Groq —
# Anthropic dropped entirely (DECISION 2026-07-30).
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_INGEST_MODEL=qwen/qwen3.6-27b
# Defaults to GROQ_MODEL if unset — set to a distinct model id to tune
# mentor/chat quality independently of the explainer.
GROQ_MENTOR_MODEL=llama-3.3-70b-versatile
